# Cloudflare R2 Data Catalog connection.
# Copy this file to .env and fill in real values.
# Never commit .env.

ICEBERG_CATALOG_URI=
ICEBERG_WAREHOUSE=
ICEBERG_TOKEN=

# Defaults for examples.
ICEBERG_CATALOG_NAME=r2
ICEBERG_NAMESPACE=demo
ICEBERG_TABLE=people
DUCKDB_CATALOG_ALIAS=r2_iceberg

# Optional bucket name used by scripts/bootstrap_r2_catalog.sh
R2_BUCKET_NAME=iceberg-lab
